{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build (release)",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-O2",
                "-DNDEBUG",
                "-march=native",
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-Wshadow",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "detail": "Optimised build, asserts off"
        },
        {
            "type": "cppbuild",
            "label": "Build (debug)",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-O0",
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-Wshadow",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}_debug.exe",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Debug build, asserts on, no optimisation"
        }
    ]
}